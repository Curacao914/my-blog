# Copy to a secret environment file outside Git.
COURSE_CONTROL_PLANE_URL=
COURSE_WORKER_SECRET=
COURSE_WORKER_OWNER_ID=

DASHSCOPE_API_KEY=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=

# Exact course names or course keys, separated by commas.
COURSE_PIPELINE_ALLOWLIST=刑法分论,国际法学
COURSE_PIPELINE_SINCE_DAYS=35
COURSE_PIPELINE_MAX_TASKS=4
COURSE_PIPELINE_LEASE_SECONDS=1800

# Use a persistent profile copied into /data/browser-profile,
# or provide credentials through the secret manager.
PKU_USERNAME=
PKU_PASSWORD=

# Optional generic JSON webhook.
COURSE_NOTIFY_WEBHOOK_URL=
COURSE_NOTIFY_WEBHOOK_BEARER=
