# Security notes for hosted deployments (Preview and Production):
# - Configure both Clerk keys and at least one CLERK_ADMIN_EMAILS or CLERK_ADMIN_USER_IDS entry.
# - Missing hosted Clerk configuration now fails closed; the private desk is not exposed.
# - ALLOW_LOCAL_DESK_FALLBACK=true is accepted only for non-Vercel local development.
# - Enable Vercel Fluid compute for durable Workflow steps.

# Notion last-known-good relay / Cloudflare R2
# Apply lib/db/migrations/20260628_notion_relay.sql before enabling.
# NOTION_RELAY_ENABLED=false
# R2_ACCOUNT_ID=5627873db128d04e0396781f999faea2
# R2_ENDPOINT=https://5627873db128d04e0396781f999faea2.r2.cloudflarestorage.com
# R2_REGION=auto
# R2_BUCKET=law-tech-assets
# R2_PUBLIC_BASE_URL=https://assets.law-tech.dev
# R2_NOTION_PREFIX=notion
# R2_NOTION_MAX_IMAGE_BYTES=15728640
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Outbound WeChat relay (local/OpenClaw machine only)
LAW_TECH_BASE_URL=https://law-tech.dev
LAW_TECH_WECHAT_TARGET=
LAW_TECH_WECHAT_POLL_MS=30000

# DeepSeek official USD prices converted for CNY display
DEEPSEEK_USD_CNY_RATE=7.20
