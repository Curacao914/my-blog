# Optional: token for iOS Shortcuts / external quick capture.
# Send as Authorization: Bearer <token> or x-law-tech-capture-token.
# TASK_CAPTURE_TOKEN=
# Optional: enterprise WeChat bot webhook for task reminders.
# TASK_REMINDER_TOKEN=
# WECOM_BOT_WEBHOOK=

# Optional: course worker model executor.
# Use an OpenAI-compatible chat completions endpoint.
# COURSE_MODEL_API_URL=https://api.example.com/v1/chat/completions
# COURSE_MODEL_API_KEY=
# COURSE_MODEL_NAME=
# COURSE_MODEL_MAX_INPUT_CHARS=800000

# Optional: PaddleOCR async API.
# PADDLEOCR_ACCESS_TOKEN=
# PADDLEOCR_DOC_PARSING_API_URL=

