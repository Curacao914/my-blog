{
  "name": "notion-next",
  "version": "4.9.4.2",
  "homepage": "https://github.com/tangly1024/NotionNext.git",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tangly1024/NotionNext.git"
  },
  "author": {
    "name": "tangly",
    "email": "mail@tangly1024.com",
    "url": "http://tangly1024.com"
  },
  "scripts": {
    "dev": "next dev",
    "build": "cross-env BUILD_MODE=true next build",
    "start": "next start",
    "post-build": "next-sitemap --config next-sitemap.config.js",
    "export": "cross-env BUILD_MODE=true EXPORT=true next build && next-sitemap --config next-sitemap.config.js",
    "bundle-report": "cross-env ANALYZE=true next build",
    "build-all-in-dev": "cross-env VERCEL_ENV=production next build",
    "version": "echo $npm_package_version",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "node scripts/quality-check.js",
    "pre-commit": "npm run lint:fix && npm run format && npm run type-check",
    "dev-tools": "node scripts/dev-tools.js",
    "init-dev": "node scripts/dev-tools.js init",
    "clean": "node scripts/dev-tools.js clean",
    "docs": "node scripts/dev-tools.js docs",
    "check-updates": "node scripts/dev-tools.js check-updates",
    "setup-hooks": "node scripts/setup-git-hooks.js install",
    "remove-hooks": "node scripts/setup-git-hooks.js remove",
    "check-hooks": "node scripts/setup-git-hooks.js check",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "health-check": "node scripts/health-check.js",
    "validate": "npm run health-check",
    "content:snapshot:validate": "node scripts/content-snapshot/promote.js --dry-run",
    "content:snapshot:promote": "node scripts/content-snapshot/promote.js",
    "content:markdown:import": "node scripts/content-snapshot/import-markdown.js",
    "content:db:import-live": "node scripts/content-snapshot/import-live-to-db.js",
    "content:db:import-live:dry-run": "node scripts/content-snapshot/import-live-to-db.js --dry-run",
    "course:worker:dry-run": "node scripts/course-worker/dry-run.js",
    "course:worker:build-pack": "node scripts/course-worker/build-pack.js",
    "course:worker:run-job": "node scripts/course-worker/run-job.js",
    "course:worker:prepare-local": "node scripts/course-worker/prepare-local.js",
    "course:worker:preprocess-local": "node scripts/course-worker/preprocess-local.js",
    "course:worker:paddle-local": "node scripts/course-worker/paddle-local.js",
    "course:worker:outline-pack": "node scripts/course-worker/outline-pack-local.js",
    "course:worker:node-pack": "node scripts/course-worker/node-pack-local.js",
    "course:worker:assemble-notes": "node scripts/course-worker/assemble-notes-local.js",
    "course:worker:model-exec": "node scripts/course-worker/model-exec-local.js",
    "course:worker:import-notes": "node scripts/course-worker/import-notes-to-content.js",
    "course:worker:cleanup-temp": "node scripts/course-worker/cleanup-temp.js",
    "course:worker:report-outlines": "node scripts/course-worker/report-outlines.js",
    "course:worker:report-preprocess": "node scripts/course-worker/report-preprocess.js",
    "tasks:reminders:due": "node scripts/tasks/due-reminders.js",
    "tasks:reminders:send": "node scripts/tasks/send-reminders.js",
    "final-validation": "node scripts/final-validation.js",
    "postinstall": "patch-package",
    "course:pipeline:sync": "bash scripts/course-worker/run-with-network.sh node scripts/course-worker/sync-platform-catalog.mjs",
    "course:pipeline:status": "bash scripts/course-worker/run-with-network.sh node scripts/course-worker/pipeline-status.mjs",
    "course:pipeline:test-client": "node --test scripts/course-worker/pipeline-client.test.mjs scripts/course-worker/platform-catalog-bridge.test.mjs",
    "course:pipeline:run": "bash scripts/course-worker/run-with-network.sh node scripts/course-worker/run-pipeline.mjs",
    "course:pipeline:test-runner": "node --test scripts/course-worker/pipeline-worker-client.test.mjs scripts/course-worker/pipeline-runner-core.test.mjs",
    "course:pipeline:run-validated": "COURSE_PIPELINE_ADAPTER_MODULE=./scripts/course-worker/validated-course-adapter.mjs bash scripts/course-worker/run-with-network.sh node scripts/course-worker/run-pipeline.mjs",
    "course:pipeline:test-adapter": "node --test scripts/course-worker/runtime/textpack-runtime.test.mjs scripts/course-worker/runtime/textpack-client.test.mjs scripts/course-worker/runtime/hls-hardening.test.mjs",
    "course:pipeline:e2e-preflight": "bash scripts/course-worker/run-with-network.sh node scripts/course-worker/e2e-preflight.mjs",
    "course:pipeline:e2e-list": "bash scripts/course-worker/run-with-network.sh node scripts/course-worker/e2e-list.mjs",
    "course:pipeline:e2e-one": "bash scripts/course-worker/run-with-network.sh node scripts/course-worker/e2e-run-one.mjs",
    "course:pipeline:test-e2e": "node --test scripts/course-worker/e2e-core.test.mjs scripts/course-worker/pipeline-worker-client.test.mjs",
    "course:pipeline:e2e-prepare": "bash scripts/course-worker/prepare-local-e2e.sh",
    "course:pipeline:test-environment": "node --test scripts/course-worker/worker-env.test.mjs scripts/course-worker/e2e-core.test.mjs",
    "course:pipeline:e2e-pilot": "bash scripts/course-worker/run-controlled-e2e.sh",
    "course:pipeline:test-network": "node --test scripts/course-worker/system-proxy.test.mjs"
  },
  "dependencies": {
    "@clerk/localizations": "^3.17.1",
    "@clerk/nextjs": "^5.7.5",
    "@headlessui/react": "^1.7.19",
    "@next/bundle-analyzer": "^12.3.7",
    "@vercel/analytics": "^1.5.0",
    "@vercel/functions": "^3.4.3",
    "algoliasearch": "^4.25.2",
    "axios": "^1.7.2",
    "critters": "^0.0.23",
    "feed": "^4.2.2",
    "ioredis": "^5.6.1",
    "js-md5": "^0.8.3",
    "jszip": "^3.10.1",
    "lodash.throttle": "^4.1.1",
    "memory-cache": "^0.2.0",
    "next": "^14.2.30",
    "notion-client": "7.10.0",
    "notion-utils": "7.10.0",
    "p-limit": "^7.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-facebook": "^8.1.4",
    "react-hotkeys-hook": "^4.6.2",
    "react-markdown": "^10.1.0",
    "react-notion-x": "7.10.0",
    "react-share": "^5.2.2",
    "react-tweet-embed": "~2.0.0",
    "workflow": "4.5.0",
    "playwright-core": "^1.53.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/node": "22.15.3",
    "@types/react": "18.3.10",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@waline/client": "^3.6.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "^13.5.11",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-junit": "^16.0.0",
    "next-sitemap": "^1.9.12",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "typescript": "5.6.2",
    "webpack-bundle-analyzer": "^4.5.0"
  },
  "resolutions": {
    "axios": ">=0.21.1"
  },
  "bugs": {
    "url": "https://github.com/tangly/NotionNext/issues",
    "email": "tlyong1992@hotmail.com"
  }
}
