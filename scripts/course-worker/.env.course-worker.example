# Local-only Course Worker configuration.
# Copy to .env.course-worker.local and never commit the real values.

# Current Vercel Preview deployment for codex/course-worker-v009c.
COURSE_CONTROL_PLANE_URL=

# Must exactly match the Vercel Preview environment value.
COURSE_WORKER_SECRET=

# Alibaba DashScope / Paraformer.
DASHSCOPE_API_KEY=

# Cloudflare R2 temporary ASR audio bucket.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=

# Optional when ~/.law-tech-course-browser-profile still has a valid session.
# Required after the reusable session expires.
PKU_USERNAME=
PKU_PASSWORD=

# Optional overrides. Auto-detection normally handles these.
# COURSE_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# COURSE_BROWSER_PROFILE_DIR=/Users/your-name/.law-tech-course-browser-profile
# COURSE_WORKER_SCRATCH_DIR=/Users/your-name/.law-tech-course-worker
# COURSE_DOWNLOAD_CONCURRENCY=6
# COURSE_ASR_CHUNK_MINUTES=45
# COURSE_HEADLESS=0
